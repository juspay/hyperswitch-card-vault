# Optional read replica
LOCKER__READ_REPLICA__USERNAME=${LOCKER_READ_REPLICA_USERNAME}
LOCKER__READ_REPLICA__PASSWORD=${LOCKER_READ_REPLICA_PASSWORD}
LOCKER__READ_REPLICA__HOST=${LOCKER_READ_REPLICA_HOST}
LOCKER__READ_REPLICA__PORT=${LOCKER_READ_REPLICA_PORT}
LOCKER__READ_REPLICA__DBNAME=${LOCKER_READ_REPLICA_DBNAME}
LOCKER__READ_REPLICA__POOL_SIZE=${LOCKER_READ_REPLICA_POOL_SIZE}

LOCKER__TENANT_SECRETS__HYPERSWITCH__REDIS_KEY_PREFIX=${LOCKER_HYPERSWITCH_REDIS_KEY_PREFIX}

# Redis configuration (only used with the `redis` feature)
LOCKER__REDIS__HOST=${LOCKER_REDIS_HOST}
LOCKER__REDIS__PORT=${LOCKER_REDIS_PORT}
LOCKER__REDIS__POOL_SIZE=${LOCKER_REDIS_POOL_SIZE}
LOCKER__REDIS__RECONNECT_MAX_ATTEMPTS=${LOCKER_REDIS_RECONNECT_MAX_ATTEMPTS}
LOCKER__REDIS__RECONNECT_DELAY=${LOCKER_REDIS_RECONNECT_DELAY}
LOCKER__REDIS__DEFAULT_TTL=${LOCKER_REDIS_DEFAULT_TTL}
LOCKER__REDIS__DEFAULT_HASH_TTL=${LOCKER_REDIS_DEFAULT_HASH_TTL}
LOCKER__REDIS__USE_LEGACY_VERSION=${LOCKER_REDIS_USE_LEGACY_VERSION}
LOCKER__REDIS__STREAM_READ_COUNT=${LOCKER_REDIS_STREAM_READ_COUNT}
LOCKER__REDIS__AUTO_PIPELINE=${LOCKER_REDIS_AUTO_PIPELINE}
LOCKER__REDIS__BROADCAST_CHANNEL_CAPACITY=${LOCKER_REDIS_BROADCAST_CHANNEL_CAPACITY}
LOCKER__REDIS__DISABLE_AUTO_BACKPRESSURE=${LOCKER_REDIS_DISABLE_AUTO_BACKPRESSURE}
LOCKER__REDIS__MAX_IN_FLIGHT_COMMANDS=${LOCKER_REDIS_MAX_IN_FLIGHT_COMMANDS}
LOCKER__REDIS__DEFAULT_COMMAND_TIMEOUT=${LOCKER_REDIS_DEFAULT_COMMAND_TIMEOUT}
LOCKER__REDIS__UNRESPONSIVE_TIMEOUT=${LOCKER_REDIS_UNRESPONSIVE_TIMEOUT}
LOCKER__REDIS__UNRESPONSIVE_CHECK_INTERVAL=${LOCKER_REDIS_UNRESPONSIVE_CHECK_INTERVAL}
LOCKER__REDIS__MAX_FEED_COUNT=${LOCKER_REDIS_MAX_FEED_COUNT}
LOCKER__REDIS__MAX_FAILURE_THRESHOLD_SECONDS=${LOCKER_REDIS_MAX_FAILURE_THRESHOLD_SECONDS}

# KV (write-through Redis) configuration: global drainer settings (only used with the `kv` feature)
LOCKER__KV__DRAINER_STREAM_SUFFIX=${LOCKER_KV_DRAINER_STREAM_SUFFIX}
LOCKER__KV__DRAINER_NUM_PARTITIONS=${LOCKER_KV_DRAINER_NUM_PARTITIONS}
LOCKER__KV__TTL_FOR_KV=${LOCKER_KV_TTL_FOR_KV}

# Metrics configuration: export metrics for monitoring.
# Mode options: disabled, otlp, prometheus
LOCKER__METRICS__MODE=${LOCKER_METRICS_MODE}
LOCKER__METRICS__ENDPOINT=${LOCKER_METRICS_ENDPOINT}
LOCKER__METRICS__ENDPOINT_TIMEOUT_SECS=${LOCKER_METRICS_ENDPOINT_TIMEOUT_SECS}
LOCKER__METRICS__METRICS_EXPORT_INTERVAL_SECS=${LOCKER_METRICS_EXPORT_INTERVAL_SECS}
LOCKER__METRICS__BACKGROUND_METRICS_COLLECTION_INTERVAL_SECS=${LOCKER_METRICS_BACKGROUND_METRICS_COLLECTION_INTERVAL_SECS}

# Prometheus metrics mode
LOCKER__METRICS__HOST=${LOCKER_METRICS_HOST}
LOCKER__METRICS__PORT=${LOCKER_METRICS_PORT}

# Runtime configuration endpoint
LOCKER__RUNTIME_CONFIG__MODE=${LOCKER_RUNTIME_CONFIG_MODE}
# Runtime config admin API key (guards POST /runtime-config)
LOCKER__RUNTIME_CONFIG__ADMIN_API_KEY=${LOCKER_RUNTIME_CONFIG_ADMIN_API_KEY}
# Seed for the `kv_config` runtime config, written to the `configs` table only when that
# row is absent. Never overwrites a live value and never used as a read-path fallback.
LOCKER__RUNTIME_CONFIG__KV_CONFIG__ENABLE_KV=${LOCKER_RUNTIME_CONFIG_KV_CONFIG_ENABLE_KV}
LOCKER__RUNTIME_CONFIG__KV_CONFIG__USE_REPLICA=${LOCKER_RUNTIME_CONFIG_KV_CONFIG_USE_REPLICA}
